# REQUIRED: generate a long random secret before deployment.
INQUISITOR_SECRET=replace-with-at-least-48-random-characters

# Disable predictable demo credentials in real events.
INQUISITOR_DEMO_ACCOUNTS=0
INQUISITOR_BOOTSTRAP_ADMIN_USER=director
INQUISITOR_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
INQUISITOR_BOOTSTRAP_ADMIN_NAME=Contest Director

# Public deployment. When HTTPS is terminated by Caddy/reverse proxy, set to 1.
INQUISITOR_SECURE_COOKIES=0
INQUISITOR_DOMAIN=inquisitor.example.edu
INQUISITOR_HTTP_PORT=8080

# Judging
INQUISITOR_JUDGE_BACKEND=docker
INQUISITOR_JUDGE_IMAGE=inquisitor-judge-runtime:1.0
INQUISITOR_JUDGE_CPUS=1
INQUISITOR_BACKUP_INTERVAL_MINUTES=30

# Leave unsafe local judging disabled in production.
INQUISITOR_ALLOW_UNSAFE_LOCAL_JUDGE=0
